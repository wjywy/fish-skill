{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keyword-signal.schema.json",
  "title": "Keyword Signal",
  "type": "object",
  "required": ["id", "type", "rawText", "normalizedValue", "sourceInputIds"],
  "properties": {
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["TARGET_ROLE", "ORGANIZATION", "DOMAIN", "PROJECT", "TECHNOLOGY", "CAPABILITY", "ACTION", "RESULT", "METRIC", "OWNERSHIP", "TIMELINE"]
    },
    "rawText": { "type": "string" },
    "normalizedValue": { "type": "string" },
    "sourceInputIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "confidence": {
      "type": "string",
      "enum": ["explicit", "normalized", "ambiguous"]
    },
    "candidateExperienceId": { "type": ["string", "null"] }
  }
}
