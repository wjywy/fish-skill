{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-resume.schema.json",
  "title": "Bootstrap Resume",
  "type": "object",
  "required": ["inputSufficiency", "target", "sections", "gaps"],
  "properties": {
    "inputSufficiency": {
      "type": "string",
      "enum": ["SPARSE", "PARTIAL", "RICH"]
    },
    "target": {
      "type": "object",
      "properties": {
        "role": { "type": ["string", "null"] },
        "jdProvided": { "type": "boolean" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "items"],
        "properties": {
          "type": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["status", "text"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["CONFIRMED", "PROVISIONAL", "GAP"]
                },
                "text": { "type": "string" },
                "sourceInputIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "missingFields": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "priority", "question"],
        "properties": {
          "field": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "question": { "type": "string" },
          "candidateExperienceId": { "type": ["string", "null"] }
        }
      }
    }
  }
}
