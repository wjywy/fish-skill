{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-answer.schema.json",
  "title": "Interview Answer",
  "type": "object",
  "required": ["id", "questionId", "text", "assessment", "extractedNodeIds"],
  "properties": {
    "id": { "type": "string" },
    "questionId": { "type": "string" },
    "text": { "type": "string" },
    "assessment": { "type": "string", "enum": ["STRONG", "PARTIAL", "WEAK", "NOT_OWNED"] },
    "extractedNodeIds": { "type": "array", "items": { "type": "string" } },
    "missingPoints": { "type": "array", "items": { "type": "string" } },
    "resumeFeedback": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
