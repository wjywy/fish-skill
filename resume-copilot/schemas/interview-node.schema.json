{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-node.schema.json",
  "title": "Interview Node",
  "type": "object",
  "required": ["id", "claimId", "concept", "nodeType", "depth", "status"],
  "properties": {
    "id": { "type": "string" },
    "claimId": { "type": "string" },
    "parentNodeId": { "type": ["string", "null"] },
    "sourceQuestionId": { "type": ["string", "null"] },
    "sourceAnswerId": { "type": ["string", "null"] },
    "concept": { "type": "string" },
    "normalizedConcept": { "type": "string" },
    "nodeType": {
      "type": "string",
      "enum": [
        "TECHNOLOGY", "MECHANISM", "PROTOCOL", "DESIGN_DECISION",
        "CONSISTENCY_SEMANTICS", "CONCURRENCY", "FAILURE_RECOVERY",
        "DATA_MODEL", "PERFORMANCE", "METRIC", "SECURITY_GOVERNANCE",
        "ARCHITECTURE", "ALTERNATIVE", "OTHER"
      ]
    },
    "depth": { "type": "integer", "minimum": 0 },
    "risk": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "jdRelevance": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
    "ownershipScope": { "type": "string", "enum": ["CAREER_CLAIM", "INTERVIEW_ONLY", "UNKNOWN"] },
    "status": {
      "type": "string",
      "enum": ["UNASKED", "ASKED", "PARTIAL", "DEFENSIBLE", "WEAK", "NOT_OWNED", "SKIPPED"]
    },
    "questionIds": { "type": "array", "items": { "type": "string" } },
    "childNodeIds": { "type": "array", "items": { "type": "string" } },
    "stopReason": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
