{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-copilot.local/schemas/candidate-fact.schema.json",
  "title": "Candidate Fact",
  "type": "object",
  "required": ["id", "statement", "status", "sourceInputIds"],
  "properties": {
    "id": {"type": "string"},
    "statement": {"type": "string"},
    "category": {
      "type": "string",
      "enum": ["context", "ownership", "action", "decision", "result", "metric", "technology", "scope", "role", "timeline", "other"]
    },
    "status": {
      "type": "string",
      "enum": ["extracted", "needs_confirmation", "confirmed", "rejected", "superseded"]
    },
    "sourceInputIds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "experienceId": {"type": ["string", "null"]},
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
