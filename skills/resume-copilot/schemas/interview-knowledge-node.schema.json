{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewKnowledgeNode",
  "type": "object",
  "required": [
    "id",
    "claimId",
    "nodeType",
    "label",
    "depth",
    "status",
    "roleRelevance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claimId": {
      "type": "string"
    },
    "parentNodeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": "string"
    },
    "normalizedLabel": {
      "type": "string"
    },
    "nodeType": {
      "enum": [
        "CONCEPT",
        "TECHNOLOGY",
        "MECHANISM",
        "PROTOCOL",
        "DATA_MODEL",
        "IMPLEMENTATION",
        "DECISION",
        "TRADEOFF",
        "ALTERNATIVE",
        "FAILURE",
        "RECOVERY",
        "CONSISTENCY",
        "CONCURRENCY",
        "IDEMPOTENCY",
        "PERFORMANCE",
        "METRIC",
        "SECURITY",
        "ARCHITECTURE",
        "OWNERSHIP"
      ]
    },
    "questionDimension": {
      "enum": [
        "DEFINITION",
        "MOTIVATION",
        "IMPLEMENTATION",
        "MECHANISM",
        "FAILURE",
        "CONSISTENCY",
        "CONCURRENCY",
        "PERFORMANCE",
        "TRADEOFF",
        "SCALING",
        "METRIC",
        "OWNERSHIP"
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "projectContext": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectGrounding": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "INSUFFICIENT",
        "NOT_APPLICABLE"
      ]
    },
    "sharedKnowledgeKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "UNEXPANDED",
        "EXPANDED",
        "COVERED",
        "MERGED",
        "DROPPED"
      ],
      "description": "UNEXPANDED=值得继续问且尚未展开；EXPANDED=已通过后续问题展开；COVERED=当前答案已经充分解释，继续追问信息增益不足；MERGED=与已有节点重复；DROPPED=低价值/越界/环路。 同一个 sourceAnswerId 可以对应多个同时处于 UNEXPANDED 的 sibling nodes；选择其中一个继续展开不得隐式删除其他 sibling。"
    },
    "stopReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "兼容字段；新数据优先使用 decisionReason。仅在 DROPPED 且需要记录停止原因时使用。"
    },
    "roleRelevance": {
      "enum": [
        "CORE",
        "RELATED",
        "CONTEXTUAL",
        "OUT_OF_SCOPE"
      ],
      "description": "该节点相对 Target Role / JD Requirements 的岗位相关性。递归是否继续主要由该字段决定，而不是与根关键词的距离。"
    },
    "roleRelevanceReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "说明该节点为何仍与目标岗位相关，或为何已脱离岗位要求。"
    },
    "sourceAnswerId": {
      "type": [
        "string",
        "null"
      ],
      "description": "该节点由哪个 Generated Answer 产生；Root Node 可为 null。"
    },
    "candidateSource": {
      "enum": [
        "ROOT",
        "EXPLICIT",
        "IMPLICIT",
        "CONTRAST",
        "BOUNDARY"
      ],
      "description": "节点来源。ROOT 仅用于根节点。"
    },
    "mergedIntoNodeId": {
      "type": [
        "string",
        "null"
      ],
      "description": "status=MERGED 时指向已存在的等价节点。"
    },
    "decisionReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "记录为何展开、合并或丢弃，用于内部可追溯性。"
    },
    "coverageStatus": {
      "enum": [
        "MENTIONED",
        "PARTIAL",
        "SUFFICIENT"
      ],
      "description": "该知识点在 sourceAnswerId 对应答案中的覆盖程度。SUFFICIENT 不代表永远不能再问；若继续追问仍有显著岗位信息增益，可创建更具体的新节点。"
    }
  },
  "$id": "interview-knowledge-node.schema.json",
  "additionalProperties": false
}
