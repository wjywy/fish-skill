{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewKnowledgeNode",
  "type": "object",
  "required": [
    "id",
    "claimId",
    "nodeType",
    "label",
    "depth",
    "status",
    "roleRelevance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claimId": {
      "type": "string"
    },
    "parentNodeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": "string"
    },
    "normalizedLabel": {
      "type": "string"
    },
    "nodeType": {
      "enum": [
        "CONCEPT",
        "TECHNOLOGY",
        "MECHANISM",
        "PROTOCOL",
        "DATA_MODEL",
        "IMPLEMENTATION",
        "DECISION",
        "TRADEOFF",
        "ALTERNATIVE",
        "FAILURE",
        "RECOVERY",
        "CONSISTENCY",
        "CONCURRENCY",
        "IDEMPOTENCY",
        "PERFORMANCE",
        "METRIC",
        "SECURITY",
        "ARCHITECTURE",
        "OWNERSHIP"
      ]
    },
    "questionDimension": {
      "enum": [
        "DEFINITION",
        "MOTIVATION",
        "IMPLEMENTATION",
        "MECHANISM",
        "FAILURE",
        "CONSISTENCY",
        "CONCURRENCY",
        "PERFORMANCE",
        "TRADEOFF",
        "SCALING",
        "METRIC",
        "OWNERSHIP"
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "projectContext": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectGrounding": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "INSUFFICIENT",
        "NOT_APPLICABLE"
      ]
    },
    "sharedKnowledgeKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "EXPANDED",
        "STOPPED"
      ]
    },
    "stopReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "roleRelevance": {
      "enum": [
        "CORE",
        "RELATED",
        "CONTEXTUAL",
        "OUT_OF_SCOPE"
      ],
      "description": "该节点相对 Target Role / JD Requirements 的岗位相关性。递归是否继续主要由该字段决定，而不是与根关键词的距离。"
    },
    "roleRelevanceReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "说明该节点为何仍与目标岗位相关，或为何已脱离岗位要求。"
    }
  }
}
