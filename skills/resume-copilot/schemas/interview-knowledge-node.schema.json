{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interview-knowledge-node.schema.json",
  "title": "InterviewKnowledgeNode",
  "type": "object",
  "required": [
    "id",
    "claimId",
    "nodeType",
    "label",
    "depth",
    "status",
    "roleRelevance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "claimId": {
      "type": "string"
    },
    "parentNodeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": "string"
    },
    "normalizedLabel": {
      "type": "string"
    },
    "nodeType": {
      "enum": [
        "CONCEPT",
        "TECHNOLOGY",
        "MECHANISM",
        "PROTOCOL",
        "DATA_MODEL",
        "IMPLEMENTATION",
        "DECISION",
        "TRADEOFF",
        "ALTERNATIVE",
        "FAILURE",
        "RECOVERY",
        "CONSISTENCY",
        "CONCURRENCY",
        "IDEMPOTENCY",
        "PERFORMANCE",
        "METRIC",
        "SECURITY",
        "ARCHITECTURE",
        "OWNERSHIP"
      ]
    },
    "questionDimension": {
      "enum": [
        "DEFINITION",
        "MOTIVATION",
        "IMPLEMENTATION",
        "MECHANISM",
        "FAILURE",
        "CONSISTENCY",
        "CONCURRENCY",
        "PERFORMANCE",
        "TRADEOFF",
        "SCALING",
        "METRIC",
        "OWNERSHIP"
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "projectContext": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectGrounding": {
      "enum": [
        "VERIFIED",
        "PARTIAL",
        "INSUFFICIENT",
        "NOT_APPLICABLE"
      ]
    },
    "sharedKnowledgeKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "UNEXPANDED",
        "EXPANDED",
        "COVERED",
        "MERGED",
        "DROPPED"
      ],
      "description": "UNEXPANDED=高价值且尚未展开；EXPANDED=已通过后续问题展开；COVERED=当前或其他答案已充分解释；MERGED=与已有节点重复；DROPPED=低价值、越界或环路。"
    },
    "roleRelevance": {
      "enum": [
        "CORE",
        "RELATED",
        "CONTEXTUAL",
        "OUT_OF_SCOPE"
      ],
      "description": "节点相对 Target Role / JD 的相关性。它参与价值与递归边界判断，但不是自动白名单。"
    },
    "roleRelevanceReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceAnswerId": {
      "type": [
        "string",
        "null"
      ],
      "description": "该节点由哪个 Generated Answer 产生；Root Node 可为 null。"
    },
    "candidateSource": {
      "enum": [
        "ROOT",
        "EXPLICIT",
        "IMPLICIT",
        "CONTRAST",
        "BOUNDARY"
      ]
    },
    "mergedIntoNodeId": {
      "type": [
        "string",
        "null"
      ],
      "description": "status=MERGED 时指向已存在的等价节点。"
    },
    "decisionReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "统一记录为何展开、覆盖、合并或丢弃。停止原因也写在这里，不再维护单独 stopReason。"
    },
    "coverageStatus": {
      "enum": [
        "MENTIONED",
        "PARTIAL",
        "SUFFICIENT"
      ],
      "description": "该知识点在 sourceAnswerId 对应答案中的覆盖程度。SUFFICIENT 时通常标记 COVERED；如果后来出现更具体的新信息需求，应创建新的具体节点。"
    }
  },
  "additionalProperties": false
}
