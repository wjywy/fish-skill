{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Resume Copilot Claim",
  "type": "object",
  "required": [
    "id",
    "experienceId",
    "factIds",
    "statement",
    "type",
    "ownership",
    "evidenceLevel",
    "confidence",
    "interviewRisk"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "experienceId": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "context",
        "responsibility",
        "implementation",
        "decision",
        "result",
        "skill",
        "architecture",
        "collaboration"
      ]
    },
    "ownership": {
      "type": "string",
      "enum": [
        "OWNER",
        "DIRECT",
        "COLLABORATIVE",
        "OBSERVED",
        "NONE"
      ]
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "inferred",
        "disputed",
        "unknown"
      ]
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metricIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowedVerbs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interviewRisk": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "resumeEligible": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "支撑该 Claim 的 Career Fact IDs。Claim 必须可回溯到 Fact。"
    }
  },
  "additionalProperties": false
}
