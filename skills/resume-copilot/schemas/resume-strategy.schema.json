{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-strategy.schema.json",
  "title": "Resume Strategy",
  "type": "object",
  "required": [
    "id",
    "targetId",
    "selectedExperienceIds",
    "selectedClaimIds",
    "sectionPlan",
    "requirementCoverage"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "statement",
          "importance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "responsibility",
              "skill",
              "domain",
              "architecture",
              "collaboration",
              "leadership",
              "outcome",
              "other"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "string",
            "enum": [
              "MUST",
              "IMPORTANT",
              "NICE_TO_HAVE"
            ]
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidenceNeeded": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceText": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "requirementCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirementId",
          "status",
          "claimIds"
        ],
        "properties": {
          "requirementId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "weakly_covered",
              "gap"
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "selectedExperienceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "selectedClaimIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "excludedClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "reason"
        ],
        "properties": {
          "claimId": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "low_relevance",
              "weak_evidence",
              "ownership_too_weak",
              "high_risk",
              "redundant",
              "space_budget",
              "not_resume_eligible",
              "other"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sectionPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "priority"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "budget": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "experienceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "emphasis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "coverageGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claimEvaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "decision",
          "reason"
        ],
        "properties": {
          "claimId": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "SELECT",
              "DEFER",
              "EXCLUDE"
            ]
          },
          "matchedRequirementIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weaknesses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
