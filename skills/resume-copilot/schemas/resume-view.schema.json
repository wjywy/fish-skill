{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-view.schema.json",
  "title": "Resume View",
  "type": "object",
  "required": [
    "id",
    "targetId",
    "header",
    "skills",
    "sections",
    "highlightClaimIds"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "header": {
      "type": "object",
      "required": [
        "name",
        "targetRole"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "targetRole": {
          "type": "string"
        },
        "educationInline": {
          "type": [
            "string",
            "null"
          ]
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "href": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "entries"
        ],
        "properties": {
          "type": {
            "enum": [
              "work",
              "project",
              "internship",
              "open_source",
              "education",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "range": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "time": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "meta": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "summaryBullets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/resumeBullet"
                  }
                },
                "bullets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/resumeBullet"
                  }
                },
                "subBlocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "title",
                      "bullets"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "bullets": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/resumeBullet"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "highlightClaimIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "renderOptions": {
      "anyOf": [
        {
          "$ref": "render-options.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "default": {
        "renderer": "kami",
        "theme": "kami-default",
        "format": "html"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resumeBullet": {
      "type": "object",
      "required": [
        "id",
        "text",
        "claimIds",
        "metricIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "该文案直接来源的 Claim IDs。"
        },
        "metricIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "该文案使用的 Metric IDs；未使用指标时为空数组。"
        }
      },
      "additionalProperties": false
    }
  }
}
