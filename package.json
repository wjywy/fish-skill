{
  "name": "fish-skill",
  "version": "0.1.16",
  "description": "A collection of reusable AI coding-agent skills, including Resume Copilot.",
  "type": "module",
  "bin": {
    "fish-skill": "./bin/fish-skill.mjs"
  },
  "files": [
    "skills/",
    "bin/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skill",
    "agent-skills",
    "coding-agent",
    "codex",
    "claude-code",
    "resume",
    "resume-copilot"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "list": "node ./bin/fish-skill.mjs list",
    "check": "node ./bin/fish-skill.mjs check",
    "test": "node ./test/run-tests.mjs && node ./test/architecture-contract.mjs",
    "test:architecture": "node ./test/architecture-contract.mjs",
    "test:diagram": "node ./test/mermaid-image.test.mjs",
    "test:report": "node ./test/run-tests.mjs --json && node ./test/architecture-contract.mjs",
    "prepack": "node ./bin/fish-skill.mjs check"
  }
}
